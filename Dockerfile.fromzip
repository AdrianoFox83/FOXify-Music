FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PORT=10000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates unzip curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "yt-dlp[default]"

WORKDIR /app

# Este Dockerfile serve para o repositório conter apenas FOXify.zip + este arquivo.
COPY FOXify.zip /tmp/foxify.zip
RUN unzip -q /tmp/foxify.zip -d /app && rm /tmp/foxify.zip

EXPOSE 10000

CMD ["python", "servidor.py"]
